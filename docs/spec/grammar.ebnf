(* wys 文法 v0.3-draft — M3 作業中（v0.2 = M2 完了時点（v0.1 = M1 サブセット。実装: crates/wys_lexer, crates/wys_parser, crates/wys_resolve）
 * v0.3 の変更: for / in、リストのリテラル、添字、添字への代入（M3 T4a）、束縛パターン Ok(x) / Err(e)（M3 T5a）、後置の ?（M3 T5b、ADR-0013）、辞書のリテラルと in / not in（M3 T6a、ADR-0015）、関数の uses 節（M3 T9a、ADR-0014）
 * v0.2 の変更: Union 型（A | B）、is / is not（T1a）、match / case（T2）、type 定義・レコード・キーワード引数・フィールド参照（T3）、Generics（T4）、モジュール（T6）
 *
 * 表記: ISO EBNF 風。{ x } は 0 回以上、[ x ] は省略可、| は選択。
 * NEWLINE / INDENT / DEDENT は字句解析器が生成する（下の「レイアウト規則」）。
 * この文書と実装が食い違う場合は、Conformance テスト（tests/conformance/）を正とし、どちらかを直す。
 *)

(* ---------- プログラム ---------- *)
module      = { NEWLINE | import | [ "pub" ] ( type_def | func_def ) } EOF ;
import      = ( "import" dotted [ "as" IDENT ] | "from" dotted "import" import_name { "," import_name } ) NEWLINE ;   (* ADR-0010、`as` は ADR-0016 *)
import_name = IDENT [ "as" IDENT ] ;
dotted      = IDENT { "." IDENT } ;                     (* a.b は エントリのディレクトリからの a/b.wys *)
type_def    = "type" IDENT [ type_params ] "=" ( record_type | type ) NEWLINE ;   (* type は予約語ではない（トップレベルの `type 名前 =` のときだけ） *)
record_type = "{" [ field_decl { "," field_decl } [ "," ] ] "}" ;
field_decl  = IDENT ":" type ;
func_def    = "def" IDENT [ type_params ] "(" [ params ] ")" "->" type [ effects ] ":" block ;
effects     = "uses" IDENT { "," IDENT } ;                (* Effect の宣言（ADR-0014）。名前は io / exit、Effect なしは pure。
                                                            uses と pure は予約語ではない（この位置でだけ意味を持つ）。`-> uses:` は型名 uses *)
type_params = "[" IDENT { "," IDENT } [ "," ] "]" ;          (* 型パラメータ。呼び出し時に引数から推論する *)
params      = param { "," param } [ "," ] ;
param       = IDENT ":" type ;                       (* 型注釈は必須（E0103） *)
type        = type_atom { "|" type_atom } ;            (* Union。平坦化・重複除去する（ADR-0006） *)
type_atom   = dotted [ "[" type { "," type } [ "," ] "]" ] | "None" ;   (* int, bool, str, None、type の名前、Pair[int, str] *)
block       = NEWLINE INDENT stmt { stmt } DEDENT ;

(* ---------- 文 ---------- *)
stmt        = simple_stmt NEWLINE | if_stmt | while_stmt | for_stmt | match_stmt ;
for_stmt    = "for" IDENT "in" expr ":" block ;          (* expr は list[T] か range(n) / range(a, b) *)
simple_stmt = "pass"
            | "return" [ expr ]
            | IDENT [ ":" type ] "=" expr             (* 代入。最初の代入で型が決まる *)
            | postfix "[" expr "]" "=" expr            (* リストの要素への代入 *)
            | expr ;
if_stmt     = "if" expr ":" block { "elif" expr ":" block } [ "else" ":" block ] ;
while_stmt  = "while" expr ":" block ;
match_stmt  = "match" expr ":" NEWLINE INDENT case_clause { case_clause } DEDENT ;
case_clause = "case" pattern ":" block ;
pattern     = IDENT "(" ")"                             (* 型パターン: int() / bool() / str() / Result() *)
            | IDENT "(" ( IDENT | "_" ) ")"             (* 束縛パターン: Ok(x) / Err(e) / Ok(_)（ADR-0013）。
                                                           束縛変数のスコープは case の本体だけ *)
            | "None"
            | "_" ;                                     (* ワイルドカード *)

(* ---------- 式（優先順位の低い順） ---------- *)
expr        = or_expr ;
or_expr     = and_expr { "or" and_expr } ;
and_expr    = not_expr { "and" not_expr } ;
not_expr    = "not" not_expr | comparison ;
comparison  = additive [ cmp_op additive | "is" [ "not" ] additive ] ;   (* 連鎖は不可（E0102）。is の右辺は None のみ（E0207） *)
cmp_op      = "==" | "!=" | "<" | "<=" | ">" | ">=" | "in" | "not" "in" ;   (* in の右辺は dict（E0909、ADR-0015） *)
additive    = term { ( "+" | "-" ) term } ;
term        = unary { ( "*" | "/" | "//" | "%" ) unary } ;   (* "/" は型検査で拒否（E0207） *)
unary       = "-" unary | postfix ;
postfix     = primary { "." IDENT [ "(" [ args ] ")" ] | "[" expr "]" | "?" } ;   (* 添字 xs[i] *)   (* フィールド参照。名前の並びの後の ( は修飾付きの呼び出し m.f(...) *)
            (* "?" は Result の伝搬（ADR-0013）。-f()? は -(f()?)。"?" の直後に "." / "[" は書けない（E0101。括弧で囲む） *)
primary     = INT | FLOAT | STRING | "True" | "False" | "None"
            | IDENT [ "(" [ args ] ")" ]
            | "[" [ expr { "," expr } [ "," ] ] "]"   (* リスト *)
            | "{" [ expr ":" expr { "," expr ":" expr } [ "," ] ] "}"   (* 辞書（ADR-0015）。空の {} は型注釈が要る（E0906） *)
            | "(" expr ")" ;
args        = arg { "," arg } [ "," ] ;
arg         = expr | IDENT "=" expr ;                  (* キーワード引数はレコードの作成専用（E0216）。位置引数より後に書く *)

(* ---------- 字句 ---------- *)
IDENT       = ( letter | "_" ) { letter | digit | "_" } ;   (* ASCII のみ。予約語を除く *)
INT         = digit { digit } ;                              (* 0 〜 2^63-1（E0005） *)
FLOAT       = digit { digit } ( "." digit { digit } [ exponent ] | exponent ) ;   (* ADR-0019。`1.` と `.5` は書けない。無限大になるものは E0009 *)
exponent    = ( "e" | "E" ) [ "+" | "-" ] digit { digit } ;
STRING      = '"' { char | escape } '"' | "'" { char | escape } "'" ;
escape      = "\" ( "n" | "t" | "r" | "0" | "\" | '"' | "'" ) ;   (* その他は E0006 *)
comment     = "#" { any character except newline } ;

(* 予約語: def return if elif else while pass True False None and or not is match case pub import from as for in
 * （match / case は Python と違いソフトキーワードではない。ユーザー決定、docs/plans/m2.md）
 *
 * レイアウト規則:
 * - 論理行の終わりに NEWLINE を生成する。空行とコメントだけの行は無視する。
 * - 行頭の空白の数がインデント幅。増えたら INDENT、外側のレベルまで減ったら DEDENT を生成する。
 *   どのレベルとも一致しない場合は E0003。インデントにタブは使えない（E0004）。
 * - 括弧 ( ) { } [ ] の内側では改行とインデントを無視する。
 * - ファイル末尾では NEWLINE と、開いているレベルの数だけ DEDENT を補う。
 *
 * 意味の規則（型検査）は docs/spec/error-codes.md の E02xx と tests/conformance/types/ を参照。
 *)
