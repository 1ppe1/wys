# float（ADR-0019）: リテラル、四則、比較、変換、表示（Python の repr と同じ）
# expect-stdout: 1.5
# expect-stdout: 4.0
# expect-stdout: 0.30000000000000004
# expect-stdout: 3.5
# expect-stdout: -2.5
# expect-stdout: -0.0
# expect-stdout: True
# expect-stdout: False
# expect-stdout: True
# expect-stdout: 10000000000.0
# expect-stdout: 1e+16
# expect-stdout: 0.0001
# expect-stdout: 1e-05
# expect-stdout: 0.0015
# expect-stdout: 2000.0
# expect-stdout: inf
# expect-stdout: -inf
# expect-stdout: 7.0
# expect-stdout: 3
# expect-stdout: -3
# expect-stdout: [1.0, 2.5]
# expect-stdout: P(x=0.5)
# expect-stdout: True
# expect-stdout: 2.5
type P = {x: float}

def half(n: int) -> float:
    return float(n) / 2.0

def main() -> None:
    print(1.5)
    print(2.0 * 2.0)
    print(0.1 + 0.2)
    print(half(7))
    print(-2.5)
    z = 0.0
    print(-z)
    print(1.5 < 2.0)
    print(0.1 + 0.2 == 0.3)
    print(2.5 >= 2.5)
    print(1e10)
    print(1e16)
    print(0.0001)
    print(0.00001)
    print(1.5e-3)
    print(2E3)
    big = 1e308
    print(big * 10.0)
    print(-big * 10.0)
    print(float(7))
    # int は 0 の方向に切り捨てる
    print(int(3.9))
    print(int(-3.9))
    print([1.0, 2.5])
    print(P(x=0.5))
    print(P(x=0.5) == P(x=0.5))
    u: float | None = 2.5
    if u is not None:
        print(u)
