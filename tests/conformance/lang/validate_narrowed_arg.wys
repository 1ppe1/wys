# validate[T] の引数は Unknown に置ける値ならよい（match で絞り込んだ Unknown、int | None、リテラル、None）
# expect-stdout: 3
# expect-stdout: 4
# expect-stdout: 5
# expect-stdout: |int|null
def main() -> None:
    u = parse_scalar("3")
    match u:
        case int():
            match validate[int](u):
                case Ok(n):
                    print(n)
                case Err(e):
                    print(e.path)
        case _:
            pass
    v: int | None = 4
    match validate[int](v):
        case Ok(n):
            print(n)
        case Err(e):
            print(e.path)
    match validate[int](5):
        case Ok(n):
            print(n)
        case Err(e):
            print(e.path)
    match validate[int](None):
        case Ok(n):
            print(n)
        case Err(e):
            print(e.path + "|" + e.expected + "|" + e.found)
