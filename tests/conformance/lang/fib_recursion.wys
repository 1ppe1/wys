# expect-stdout: 1
# expect-stdout: 1
# expect-stdout: 2
# expect-stdout: 3
# expect-stdout: 5
# expect-stdout: 55
def fib(n: int) -> int:
    if n < 2:
        return n
    return fib(n - 1) + fib(n - 2)

def main() -> None:
    i = 0
    while i < 6:
        print(fib(i))
        i = i + 1
    print(fib(10))
