# レコードの定義・作成・フィールド参照・引数と戻り値（キーワード引数はどの順でもよい）
# expect-stdout: 3
# expect-stdout: 4
# expect-stdout: 7
# expect-stdout: origin
def add(a: Point, b: Point) -> Point:
    return Point(y=a.y + b.y, x=a.x + b.x)

def label(p: Point) -> str:
    if p.x == 0 and p.y == 0:
        return "origin"
    return "elsewhere"

type Point = {x: int, y: int}

def main() -> None:
    p = add(Point(x=1, y=1), Point(x=2, y=3))
    print(p.x)
    print(p.y)
    print(p.x + p.y)
    print(label(Point(x=0, y=0)))
