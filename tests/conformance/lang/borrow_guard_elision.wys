# Move 最適化（M4 T3）: 可変な場所から読んだ値の保持と、代入しない引数の retain / release を取り除いても、
# 値は正しく、解放漏れも二重解放もない（3つのモードで生存オブジェクト 0、AddressSanitizer）
# expect-stdout: a
# expect-stdout: 2
# expect-stdout: b!
# expect-stdout: [a, b!!]
# expect-stdout: a
def shout(s: str) -> str:
    return s + "!"

def same(s: str) -> str:
    return s

def main() -> None:
    xs = ["a", "b"]
    d = {"k": "vv"}
    print(xs[0])
    print(len(d["k"]))
    print(xs[1] + "!")
    # 読んだ後に要素を書き換える（書き換えは最後の使用の後なので、保持は要らない）
    xs[1] = shout(xs[1]) + "!"
    print("[" + xs[0] + ", " + xs[1] + "]")
    # 引数のまま返す関数（代入しない引数）
    print(same(xs[0]))
