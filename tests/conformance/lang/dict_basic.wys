# dict のリテラル・添字・上書き・len・in / not in。反復は挿入順（ADR-0015）
# expect-stdout: 3
# expect-stdout: 1
# expect-stdout: 20
# expect-stdout: True
# expect-stdout: False
# expect-stdout: True
# expect-stdout: a 1
# expect-stdout: b 20
# expect-stdout: c 3
# expect-stdout: z 26
# expect-stdout: 4
# expect-stdout: 4
def show(d: dict[str, int]) -> None:
    for k in d:
        print(k + " " + str_of(d[k]))

def str_of(n: int) -> str:
    if n == 1:
        return "1"
    if n == 3:
        return "3"
    if n == 20:
        return "20"
    return "26"

def add_z(d: dict[str, int]) -> None:
    d["z"] = 26

def main() -> None:
    d = {"a": 1, "b": 2, "c": 3}
    print(len(d))
    print(d["a"])
    d["b"] = 20
    print(d["b"])
    print("a" in d)
    print("x" in d)
    print("x" not in d)
    e = d
    add_z(e)
    show(d)
    print(len(d))
    print(len(e))
