# 別のタスクで弾かれたツールの印は、sleep_ms で中断していたツールの結果に持ち越さない（Fable のレビューで直した）
# expect-stdout: a ok a done
# expect-stdout: b err schema: tool `add`: a: expected int, found str
@tool(description="Waits.")
async def wait() -> None uses pure:
    await sleep_ms(10)

@tool(description="Add.")
def add(a: int, b: int) -> int uses pure:
    return a + b

@agent(tools=[wait], capabilities=["llm"])
async def a() -> Result[str, LlmError] uses llm:
    req = LlmRequest(model="", system="", messages=[Message(role="user", content="a")], max_tokens=0)
    return await llm_generate[str](req)

@agent(tools=[add], capabilities=["llm"])
async def b() -> Result[str, LlmError] uses llm:
    req = LlmRequest(model="", system="", messages=[Message(role="user", content="b")], max_tokens=0)
    return await llm_generate[str](req)

async def main() -> None uses io, llm:
    llm_mock_push(MockResponse(text="", tool_calls=[MockToolCall(name="wait", args_json="{}")], input_tokens=1, output_tokens=1, latency_ms=0))
    llm_mock_push(MockResponse(text="", tool_calls=[MockToolCall(name="add", args_json="{\"a\": \"x\", \"b\": 1}")], input_tokens=1, output_tokens=1, latency_ms=0))
    llm_mock_push(MockResponse(text="a done", tool_calls=[], input_tokens=1, output_tokens=1, latency_ms=0))
    ta = spawn(a())
    tb = spawn(b())
    match await ta:
        case Ok(t):
            print("a ok " + t)
        case Err(e):
            print("a err " + e.kind + ": " + e.message)
    match await tb:
        case Ok(t):
            print("b ok " + t)
        case Err(e):
            print("b err " + e.kind + ": " + e.message)
