# 配備時に Capability を縮めると、そのツールは実行の前に拒否される（ADR-0023 論点 8・10）
# expect-env: WYS_CAPABILITIES=io,llm
# expect-stdout: denied
# expect-stdout: tool_denied run_py missing capability python
@tool(description="Uses Python.")
def run_py() -> None uses python:
    pass

@agent(tools=[run_py], capabilities=["io", "llm", "python"])
async def planner() -> Result[str, LlmError] uses io, llm, python:
    req = LlmRequest(model="", system="", messages=[Message(role="user", content="go")], max_tokens=0)
    return await llm_generate[str](req)

async def main() -> None uses io, llm, python:
    llm_mock_push(MockResponse(text="", tool_calls=[MockToolCall(name="run_py", args_json="{}")], input_tokens=1, output_tokens=1, latency_ms=0))
    match await planner():
        case Ok(t):
            print(t)
        case Err(e):
            print(e.kind)
    for ev in audit_events():
        match ev.tool:
            case str():
                if ev.kind == "tool_denied":
                    print(ev.kind + " " + ev.tool + " " + ev.detail)
            case None:
                pass
