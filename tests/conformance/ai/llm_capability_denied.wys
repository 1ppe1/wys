# WYS_CAPABILITIES で llm を外すと、llm_generate は呼ぶ前に拒否される（ADR-0023 論点 8・11）
# expect-env: WYS_CAPABILITIES=io
# expect-stdout: denied
# expect-stdout: capability_denied llm_generate
async def main() -> None uses io, llm:
    llm_mock_push(MockResponse(text="hi", tool_calls=[], input_tokens=1, output_tokens=1, latency_ms=0))
    req = LlmRequest(model="", system="", messages=[Message(role="user", content="x")], max_tokens=0)
    match await llm_generate[str](req):
        case Ok(t):
            print(t)
        case Err(e):
            print(e.kind)
    for ev in audit_events():
        match ev.tool:
            case str():
                print(ev.kind + " " + ev.tool)
            case None:
                print(ev.kind)
