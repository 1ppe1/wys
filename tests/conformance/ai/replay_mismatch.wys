# 要求が記録と違えば Err(kind="replay")。2 回目の呼び出しも同じ失敗を返す（ADR-0025 論点 8）
# expect-env: WYS_LLM_PROVIDER=replay:${CASE_DIR}/recordings/tool_round_trip.jsonl
# expect-stdout: replay: request 1: messages[0].content differs
# expect-stdout: replay: request 1: messages[0].content differs
type Plan = {title: str, steps: int}

@tool(description="Add two integers.")
def add(a: int, b: int) -> int uses io:
    print("add " + to_json(a) + " " + to_json(b))
    return a + b

@agent(tools=[add], timeout_ms=50)
async def planner(goal: str) -> Result[Plan, LlmError] uses io, llm:
    req = LlmRequest(
        model="",
        system="Plan.",
        messages=[Message(role="user", content=goal)],
        max_tokens=0
    )
    return await llm_generate[Plan](req)

async def run(goal: str) -> None uses io, llm:
    match await planner(goal):
        case Ok(p):
            print(p.title + " " + to_json(p.steps))
        case Err(e):
            print(e.kind + ": " + e.message)

async def main() -> None uses io, llm:
    await run("six")
    await run("five")
