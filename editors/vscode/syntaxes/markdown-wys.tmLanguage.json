{
  "scopeName": "markdown.wys.codeblock",
  "injectionSelector": "L:text.html.markdown",
  "patterns": [
    {
      "begin": "(^|\\G)(\\s*)((`|~)\\4{2,})\\s*(?i:(wys)(\\s+[^`~]*)?$)",
      "end": "(^|\\G)(\\2|\\s{0,3})(\\3\\4*)\\s*$",
      "name": "markup.fenced_code.block.markdown",
      "beginCaptures": {
        "3": {
          "name": "punctuation.definition.markdown"
        },
        "5": {
          "name": "fenced_code.block.language.markdown"
        }
      },
      "endCaptures": {
        "3": {
          "name": "punctuation.definition.markdown"
        }
      },
      "patterns": [
        {
          "begin": "(^|\\G)(\\s*)(.*)",
          "while": "(^|\\G)(?!\\s*([`~]{3,})\\s*$)",
          "contentName": "meta.embedded.block.wys",
          "patterns": [
            {
              "include": "source.wys"
            }
          ]
        }
      ]
    }
  ]
}
